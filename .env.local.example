# ─────────────────────────────────────────────────────────────────────────────
# NewSXA — Environment Variables
# Copy this file to .env.local and fill in real values before running locally.
# Never commit .env.local to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase Admin SDK (server-side) ─────────────────────────────────────────
# Required for server auth (getServerAuth), Firestore Admin reads, etc.
# Obtain from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Paste the private key from the service-account JSON with newline escapes.
# Do not include a real key in this example file.
FIREBASE_PRIVATE_KEY="replace-with-service-account-private-key"

# ── Firebase Client SDK (browser-side, safe to expose) ───────────────────────
# Obtain from Firebase Console → Project Settings → Your apps → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Admin Access Control ──────────────────────────────────────────────────────
# Comma-separated list of Google email addresses that receive admin access.
# Users on this list are routed to /admin after login; all others go to /portal.
# REQUIRED — if left empty, no account will have admin access.
ADMIN_EMAILS="ops@sxaudits.com,admin@sxaudits.com"

# Email shown in the dev-bypass admin button on the login page.
# Must match one of the ADMIN_EMAILS values so server-side isEmailAdmin() passes.
# Only active when both dev bypass flags below are true. Safe to omit in prod.
NEXT_PUBLIC_DEV_ADMIN_EMAIL="ops@sxaudits.com"
NEXT_PUBLIC_ENABLE_DEV_BYPASS=false
SX_ENABLE_DEV_BYPASS=false

# ── Hermes / SX Internal API ──────────────────────────────────────────────────
# Secret key that Hermes runtime uses to authenticate internal API calls.
# Must match the value configured in the Hermes agent runtime.
# REQUIRED in production — no default is used. Generate a strong random value.
SX_API_SERVER_KEY=sx-local-dev-key

# The public-facing URL of the Next.js app.
# Used to configure Hermes API server CORS so it only accepts requests from
# this origin.  Must be set in production (e.g. https://app.sxaudits.com).
SX_PUBLIC_URL=http://localhost:3000

# ── Telegram Hermes Bot ───────────────────────────────────────────────────────
# Create a bot with BotFather, then set the webhook to:
# https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/setWebhook?url=<SX_PUBLIC_URL>/api/telegram/hermes&secret_token=<TELEGRAM_WEBHOOK_SECRET>
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-random-webhook-secret
# Optional comma-separated chat IDs. Leave blank only if any chat with the bot
# should be allowed through the webhook secret.
TELEGRAM_ALLOWED_CHAT_IDS=

# Used for Telegram image understanding AND as the Hermes cloud fallback on
# Vercel (when the local Hermes binary is unavailable). Required in production.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# ── Google Drive (client folders + upload links) ─────────────────────────────
# Used to create per-order folders, store upload links, and let Hermes inspect
# client uploads in Drive.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://sxaudits.com/api/auth/google/callback
GOOGLE_REFRESH_TOKEN=your-google-refresh-token
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-google-drive-root-folder-id

# Optional confirmation email transport. If unset, the app skips email sending
# but still creates Drive folders and stores the upload links.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="Sovereign X Audits <no-reply@sxaudits.com>"

# ── Upstash Redis (production state store) ────────────────────────────────────
# Create a free database at upstash.com → Redis → Create Database.
# Copy the REST URL and token from the database details page.
# REQUIRED on Vercel. Without this, state won't persist between requests.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── Cron Security ─────────────────────────────────────────────────────────────
# Vercel generates this automatically when crons are configured.
# Copy from: Vercel Dashboard → Project → Settings → Cron Jobs → CRON_SECRET
CRON_SECRET=

# ── Perplexity (live search for Outreach + Research agents) ──────────────────
# Get a free key at perplexity.ai/settings/api
PERPLEXITY_API_KEY=
