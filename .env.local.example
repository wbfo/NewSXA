# ─────────────────────────────────────────────────────────────────────────────
# NewSXA — Environment Variables
# Copy this file to .env.local and fill in real values before running locally.
# Never commit .env.local to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase Admin SDK (server-side) ─────────────────────────────────────────
# Required for server auth (getServerAuth), Firestore Admin reads, etc.
# Obtain from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Paste the private key from the service-account JSON with newline escapes.
# Do not include a real key in this example file.
FIREBASE_PRIVATE_KEY="replace-with-service-account-private-key"

# ── Firebase Client SDK (browser-side, safe to expose) ───────────────────────
# Obtain from Firebase Console → Project Settings → Your apps → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Admin Access Control ──────────────────────────────────────────────────────
# Comma-separated list of Google email addresses that receive admin access.
# Users on this list are routed to /admin after login; all others go to /portal.
# REQUIRED — if left empty, no account will have admin access.
ADMIN_EMAILS="ops@sxaudits.com,admin@sxaudits.com"

# Email shown in the dev-bypass admin button on the login page.
# Must match one of the ADMIN_EMAILS values so server-side isEmailAdmin() passes.
# Only active when both dev bypass flags below are true. Safe to omit in prod.
NEXT_PUBLIC_DEV_ADMIN_EMAIL="ops@sxaudits.com"
NEXT_PUBLIC_ENABLE_DEV_BYPASS=false
SX_ENABLE_DEV_BYPASS=false

# ── Hermes / SX Internal API ──────────────────────────────────────────────────
# Secret key that Hermes runtime uses to authenticate internal API calls.
# Must match the value configured in the Hermes agent runtime.
# REQUIRED in production — no default is used. Generate a strong random value.
SX_API_SERVER_KEY=sx-local-dev-key

# The public-facing URL of the Next.js app.
# Used to configure Hermes API server CORS so it only accepts requests from
# this origin.  Must be set in production (e.g. https://app.sxaudits.com).
SX_PUBLIC_URL=http://localhost:3000
